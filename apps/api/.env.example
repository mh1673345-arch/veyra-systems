# Copy to apps/api/.env for local development.

PORT=
NODE_ENV=

# Development database only: veyra_dev on the local Docker Postgres
# (docker-compose.yml). Use the VEYRA_PG_PASSWORD from the repo-root .env.
# The test suite uses apps/api/.env.test (veyra_test) and never touches this
# database — see the "Database environments" section of the README.
# Production supplies its own DATABASE_URL; never reuse these credentials.
DATABASE_URL=

# Placeholder API key required on all /api/* requests (see src/middleware/auth.ts).
# This is a stand-in for real receptionist-account auth, not production-grade security.
VEYRA_API_KEY=

# --- AI receptionist provider ---
# Get a key at https://console.anthropic.com/settings/keys.
# Server-side only — never sent to or read by the browser. When unset, the API
# automatically falls back to the deterministic rule-based responder
# (src/services/ai/ruleBasedResponder.ts) so the app still runs with zero keys.
# ANTHROPIC_API_KEY=

# Optional: override the model (defaults to claude-sonnet-5).
# ANTHROPIC_MODEL=

# --- Notification worker leases ---
# A claimed notification is owned for this long without renewal; an active
# delivery renews it every HEARTBEAT ms. Heartbeat must be <= lease / 2.
# VEYRA_NOTIFICATION_LEASE_MS=
# VEYRA_NOTIFICATION_HEARTBEAT_MS=
# VEYRA_DISABLE_WORKER=

# --- Operator dashboard ---
# Origin(s) allowed to send the session cookie (comma-separated).
# VEYRA_WEB_ORIGIN=

# Development operator accounts created by the seed. Local values only —
# the seed refuses to create these when NODE_ENV=production.
# VEYRA_DEV_PASSWORD=
# VEYRA_DEV_OWNER_EMAIL=
# VEYRA_DEV_OPERATOR_EMAIL=
# VEYRA_DEV_VIEWER_EMAIL=

# --- Calendar ---
# Encrypts stored calendar OAuth tokens. Generate: openssl rand -base64 32
VEYRA_ENCRYPTION_KEY=
# Google Calendar OAuth client. Without these, businesses cannot connect a
# calendar and Veyra stays booking-request-only.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Externally configurable so production points at its own domain.
# GOOGLE_REDIRECT_URI=

# --- Billing ---
# Which payment provider to use. Unset means no billing: the Console shows
# plans but cannot sell them, and never fakes a checkout.
#   fake    development/test only - signs real webhooks, charges nothing,
#           and is refused when NODE_ENV=production
#   stripe  requires both Stripe secrets below
# VEYRA_BILLING_PROVIDER=

# Prices. A plan with no price id configured cannot be bought; Starter has none
# by default, which makes it the free plan. Amounts are in minor units.
# VEYRA_BILLING_PRO_PRICE_ID=
# VEYRA_BILLING_PRO_AMOUNT=
# VEYRA_BILLING_PRO_CURRENCY=
# VEYRA_BILLING_PRO_INTERVAL=
# VEYRA_BILLING_MAX_PRICE_ID=
# VEYRA_BILLING_MAX_AMOUNT=
# Set once pricing is approved; until then the Console labels prices as examples.
# VEYRA_BILLING_PRICES_FINAL=
# No trial is offered unless this is set.
# VEYRA_BILLING_TRIAL_DAYS=

# Stripe (server-side only, never sent to the browser). Both are required
# before Stripe counts as configured. Use test-mode keys.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# The API's own public URL, used for provider-facing URLs (webhook delivery and
# the development provider's checkout page).
# VEYRA_PUBLIC_API_URL=

# Development provider only: the secret its webhooks are signed with, and
# whether queued events are delivered automatically (default: on in development).
# VEYRA_FAKE_BILLING_WEBHOOK_SECRET=
# VEYRA_FAKE_BILLING_AUTODELIVER=

# --- Demo and pilot operations ---
# Which business the public Reception demo (/) talks to. Without this, the
# demo falls back to the OLDEST business with Reception live and a service, so
# a newly created workspace can never become the demo by accident.
# Required by `npm run demo:reset -w apps/api`, which refuses to touch anything
# else.
# VEYRA_DEMO_BUSINESS_ID=

# --- Voice (Max = Speak) ---
# Which telephony provider answers the phone. Unset means no voice: Max still
# grants the entitlement and the Console says voice needs setting up.
#   fake    development/test only - signs real webhooks, places no calls, and
#           is refused when NODE_ENV=production
#   twilio  requires both Twilio credentials below
# VEYRA_VOICE_PROVIDER=

# Twilio (server-side only). Both are required before Twilio counts as
# configured. NOT VERIFIED: no real call has been made through this adapter.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Development voice provider only: the secret its webhooks are signed with.
# VEYRA_FAKE_VOICE_WEBHOOK_SECRET=

# --- Streaming speech (Phase 14) ---
# Recognition and synthesis are configured separately from the carrier: a real
# key selects the real vendor, and the development stand-ins are used only when
# no key is present, and never in production.

# Deepgram — streaming speech recognition. NOT VERIFIED: no real audio has been
# transcribed. Endpoint, model and endpointing are overridable so a vendor
# change needs no code change.
# DEEPGRAM_API_KEY=
# DEEPGRAM_STT_URL=
# DEEPGRAM_MODEL=
# DEEPGRAM_ENDPOINTING_MS=
# DEEPGRAM_UTTERANCE_END_MS=

# ElevenLabs — streaming speech synthesis. NOT VERIFIED: no audio has been
# produced. The three voice ids map Veyra's fixed profiles (neutral/warm/bright);
# a business can never supply a raw voice id.
# ELEVENLABS_API_KEY=
# ELEVENLABS_TTS_URL=
# ELEVENLABS_MODEL=
# ELEVENLABS_VOICE_NEUTRAL=
# ELEVENLABS_VOICE_WARM=
# ELEVENLABS_VOICE_BRIGHT=

# The public HTTPS base a carrier calls back on. Required before Twilio can
# reach this server at all, and used to build the media-stream wss:// URL.
# VEYRA_PUBLIC_API_URL=

# --- Email delivery ---
# The provider is chosen explicitly, never inferred from NODE_ENV. Valid values
# are "resend" and "console"; anything else, or a "resend" with missing
# credentials, fails closed and is reported at startup as email=unconfigured.
#
# "console" captures messages in the server log instead of sending them. It is
# the development default and is refused outright in production.
# VEYRA_EMAIL_PROVIDER=

# Resend. VEYRA_EMAIL_FROM must be a sender Resend has verified for the
# account; onboarding@resend.dev is Resend's sandbox sender, which can only
# deliver to the address that owns the account. Reply-to is optional — when
# unset, no reply-to header is sent.
# VEYRA_EMAIL_PROVIDER=
# RESEND_API_KEY=
# VEYRA_EMAIL_FROM=
# VEYRA_EMAIL_REPLY_TO=
# RESEND_API_URL=

# --- Messaging (SMS / WhatsApp) ---
# Which adapter serves a channel is a per-business setting, not an env var:
# see MessagingSettings. No provider credential belongs in a business row, and
# no real SMS or WhatsApp vendor is wired up yet.
#
# The development messaging provider still verifies webhook signatures, so it
# needs a secret. Without one, messaging webhooks are refused outright rather
# than accepted unverified. Never set in production — the fake adapter is
# refused there regardless.
# VEYRA_FAKE_MESSAGING_WEBHOOK_SECRET=

# --- WhatsApp via Meta Cloud API ---
# Set VEYRA's business messaging settings to whatsappProvider="meta" to use
# these. The token is the one credential that matters: a temporary token from
# the Meta dashboard expires after 24 hours, and the provider says so by name
# when it does. A System User token is what a long-lived setup needs.
#
# META_WHATSAPP_PHONE_NUMBER_ID is the sender's Cloud API id, not a phone
# number. On a test app, Meta only delivers to recipients added to the
# allow-list in the dashboard; anything else is refused and not retried.
# META_WHATSAPP_ACCESS_TOKEN=
# META_WHATSAPP_PHONE_NUMBER_ID=
# META_WHATSAPP_BUSINESS_ACCOUNT_ID=
# Shared secret Meta echoes back when verifying the webhook subscription.
# META_WHATSAPP_VERIFY_TOKEN=
# META_GRAPH_VERSION=
# META_GRAPH_URL=

# Meta webhook. The app secret signs every POST (X-Hub-Signature-256) and the
# verify token is echoed back during the subscription handshake. Without BOTH,
# Veyra cannot tell a genuine webhook from a forged one and refuses every
# inbound event rather than trusting it.
# META_APP_SECRET=
#
# Set to "false" once the access token is a long-lived System User token, to
# silence the temporary-credential warning in the Console.
# META_WHATSAPP_TOKEN_IS_TEMPORARY=

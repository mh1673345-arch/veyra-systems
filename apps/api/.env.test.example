# Copy to apps/api/.env.test (gitignored). Loaded with override by
# tests/setup.ts and scripts/reset-test-db.mjs, so the suite can never touch
# the development database.
#
# Must name the veyra_test database on a local host: the suite resets it
# destructively and the reset script refuses anything else.
# Password: the VEYRA_PG_PASSWORD from the repo-root .env (docker-compose.yml).
NODE_ENV=
DATABASE_URL=
VEYRA_API_KEY=

# Never set a real provider key here — the suite mocks the Anthropic SDK and
# must not make paid calls.

# --- Calendar ---
# Encrypts stored calendar OAuth tokens. Generate: openssl rand -base64 32
VEYRA_ENCRYPTION_KEY=
